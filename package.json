{
  "name": "interactive-3d-map",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run check:layout && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "node --test \"tests/*.test.mjs\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:layout": "node tools/check-layout.mjs",
    "assets": "node tools/assets/generate.mjs",
    "assets:validate": "node tools/assets/validate.mjs",
    "assets:preview": "node tools/assets/serve.mjs",
    "assets:render": "node tools/assets/render.mjs",
    "assets:determinism": "node tools/assets/determinism.mjs",
    "perf": "node tools/perf.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@fontsource/roboto": "5.3.0",
    "@gltf-transform/core": "4.5.1",
    "@types/three": "0.187.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright": "1.65.0",
    "three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
