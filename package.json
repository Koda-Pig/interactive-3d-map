{
  "name": "@protium/bmr-map",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run check:layout && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "node --test \"tests/*.test.mjs\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:layout": "node tools/check-layout.mjs",
    "assets": "node tools/assets/generate.mjs",
    "assets:validate": "node tools/assets/validate.mjs",
    "assets:preview": "node tools/assets/serve.mjs",
    "assets:render": "node tools/assets/render.mjs",
    "assets:determinism": "node tools/assets/determinism.mjs",
    "assets:people": "node tools/assets/people.mjs",
    "perf": "node tools/perf.mjs",
    "build:package": "node tools/build-package.mjs",
    "check:package": "node --test tests/package.test.mjs",
    "test:browser": "node tools/check-map-browser.mjs",
    "prepack": "node tools/verify-package.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@fontsource/roboto": "5.3.0",
    "@gltf-transform/core": "4.5.1",
    "@types/three": "0.187.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.1.1",
    "playwright": "1.65.0",
    "three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "react": "19.3.0",
    "@types/react": "^19.0.0",
    "react-dom": "19.3.0"
  },
  "version": "0.1.0",
  "files": [
    "dist",
    "tools/copy-assets.mjs",
    "LICENSES.md",
    "tools/verify-package.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "bmr-map-copy-assets": "./tools/copy-assets.mjs"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted"
  }
}
